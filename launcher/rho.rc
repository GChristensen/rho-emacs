  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "\x03C1Emacs launcher\0"
      VALUE "ProductName", "\x03C1Emacs\0"
      VALUE "FileVersion", "1.3.0\0"
      VALUE "OriginalFilename", "rho.exe\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
